<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Gazebo Harmonic (gz sim), o par do ROS 2 Jazzy -->

    <!-- ===== Parametros do sensor (LDROBOT LD14P, kit Waveshare D200) =====
         Datasheet (botnroll SEN03085): alcance 0.1 a 8 m, 360 graus, 4000 amostras/s,
         scan 6 Hz por omissao (2-8 Hz via UART, 230400 baud), precisao alvo branco:
         +-5 mm (0.1-0.5 m), +-10 mm (0.5 m), +-1 % (1-6 m), +-1.5 % (6-8 m).
         Pontos por volta = 4000 / scan_hz  ->  6 Hz = 667 pontos (~0.54 graus); 8 Hz = 500 (~0.72 graus).
         Ruido: o gpu_lidar so aceita desvio-padrao constante; 0.01 m ~ +-1 % a 1 m (a 2 m o real e ~0.02).
         Nao ha 'altura do plano' no datasheet: o plano fica a lidar_z (robot_core.xacro) = resto_top + lidar_plane_h (estimativa,
         medir no sensor real). Tem de ficar entre 130 mm (paredes) e 210 mm (pilares) acima do chao. -->
    <xacro:property name="lidar_samples" value="667"/>
    <xacro:property name="lidar_rate" value="6"/>
    <xacro:property name="lidar_min_range" value="0.1"/>
    <xacro:property name="lidar_max_range" value="8.0"/>
    <xacro:property name="lidar_noise_std" value="0.01"/>

    <!-- ===== Atrito =====
         Os links filhos de juntas fixas seriam fundidos no pai pelo conversor URDF->SDF e o atrito
         das esferas perdia-se. preserveFixedJoint mantem as esferas como links proprios. -->
    <gazebo reference="caster_front_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="caster_rear_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>

    <!-- esferas livres: sem atrito (rolam em qualquer direcao) -->
    <gazebo reference="caster_front">
        <mu1>0.0</mu1><mu2>0.0</mu2>
    </gazebo>
    <gazebo reference="caster_rear">
        <mu1>0.0</mu1><mu2>0.0</mu2>
    </gazebo>

    <!-- pneus (borracha/TPU sobre papel/vinil do tapete): atrito alto, sem escorregar -->
    <gazebo reference="left_wheel">
        <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="right_wheel">
        <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>

    <!-- chassis nao deve ter atrito alto se bater numa parede -->
    <gazebo reference="chassis">
        <mu1>0.3</mu1><mu2>0.3</mu2>
    </gazebo>

    <!-- ===== LIDAR ===== -->
    <gazebo reference="laser_frame">
        <sensor name="d200_lidar" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <gz_frame_id>laser_frame</gz_frame_id>
            <update_rate>${lidar_rate}</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>${lidar_samples}</samples>
                        <resolution>1</resolution>
                        <min_angle>${-pi}</min_angle>
                        <max_angle>${pi}</max_angle>
                    </horizontal>
                    <!-- plano unico (2D) -->
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>${lidar_min_range}</min>
                    <max>${lidar_max_range}</max>
                    <resolution>0.001</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>${lidar_noise_std}</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>

    <!-- ===== Controlo diferencial + estado das juntas ===== -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <!-- distancia entre os centros dos pneus, medida no CAD (90.8 mm) -->
            <wheel_separation>${wheel_separation}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <odom_publish_frequency>50</odom_publish_frequency>
            <!-- limites coerentes com o motor (ver motor_max_speed em robot_core.xacro) -->
            <max_linear_velocity>${0.9*motor_max_speed*wheel_radius}</max_linear_velocity>
            <min_linear_velocity>${-0.9*motor_max_speed*wheel_radius}</min_linear_velocity>
            <max_angular_velocity>${0.9*2*motor_max_speed*wheel_radius/wheel_separation}</max_angular_velocity>
            <min_angular_velocity>${-0.9*2*motor_max_speed*wheel_radius/wheel_separation}</min_angular_velocity>
            <max_linear_acceleration>2.0</max_linear_acceleration>
            <min_linear_acceleration>-2.0</min_linear_acceleration>
            <max_angular_acceleration>12.0</max_angular_acceleration>
            <min_angular_acceleration>-12.0</min_angular_acceleration>
        </plugin>

        <!-- topic explicito: por omissao o gz publica em /world/<mundo>/model/<nome>/joint_state
             e a ponte para /joint_states nunca recebia nada (sem TF das rodas no RViz) -->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

</robot>
